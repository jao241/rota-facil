generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique @db.VarChar(320)
  name         String?
  cpfHash      String?   @unique @db.Char(64)
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  maps         Map[]
  mapAccess    MapAccess[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique @db.Char(64)
  userId    String
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Map {
  id          String   @id @default(cuid())
  userId      String
  name        String   @db.VarChar(120)
  description String?  @db.VarChar(1000)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  access      MapAccess[]
  points      MapPoint[]
  route       MapRoute?

  @@index([userId, updatedAt])
}

model MapPoint {
  id        String   @id @default(cuid())
  mapId     String
  name      String?  @db.VarChar(80)
  latitude  Float    @db.DoublePrecision
  longitude Float    @db.DoublePrecision
  position  Int
  visitedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@unique([mapId, position])
  @@index([mapId, position])
}

model MapRoute {
  id            String   @id @default(cuid())
  mapId         String   @unique
  geometry      Json?
  costing       String   @default("auto") @db.VarChar(40)
  calculatedAt DateTime?
  error         String?  @db.VarChar(500)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  map           Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
}

model MapAccess {
  mapId     String
  userId    String
  createdAt DateTime @default(now())
  map       Map @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([mapId, userId])
  @@index([userId])
}
